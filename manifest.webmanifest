{
 "name": "동영상 자르기",
 "short_name": "영상자르기",
 "start_url": "./",
 "scope": "./",
 "display": "fullscreen",
 "display_override": [
  "fullscreen",
  "standalone"
 ],
 "background_color": "#161616",
 "theme_color": "#161616",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "files": [
    {
     "name": "video",
     "accept": [
      "video/*",
      ".mp4",
      ".mov",
      ".m4v"
     ]
    }
   ]
  }
 }
}